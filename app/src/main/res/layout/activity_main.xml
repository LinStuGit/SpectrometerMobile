<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FFFFFF">

    <!-- 左侧：光谱图 + 状态 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="15sp"
            android:textColor="#222222"
            android:text="@string/status_ready" />

        <com.linstu.spectrometermobile.ui.SpectrumView
            android:id="@+id/spectrumView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button android:id="@+id/btnRun" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/run" android:textSize="13sp" />
            <Button android:id="@+id/btnStop" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/stop" android:textSize="13sp" />
            <Button android:id="@+id/btnBackground" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/background" android:textSize="13sp" />
            <Button android:id="@+id/btnReference" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/reference" android:textSize="13sp" />
            <Button android:id="@+id/btnSave" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/save" android:textSize="13sp" />
            <Button android:id="@+id/btnLoad" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/load" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧：参数面板（可滚动） -->
    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="#F4F6F8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="采集区域 (千分数)" android:textStyle="bold" android:textSize="14sp" />
            <EditText android:id="@+id/etStartX" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="StartX 0" android:inputType="number" android:text="0" android:textSize="13sp"/>
            <EditText android:id="@+id/etEndX" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="EndX 1000" android:inputType="number" android:text="1000" android:textSize="13sp"/>
            <EditText android:id="@+id/etStartY" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="StartY 400" android:inputType="number" android:text="400" android:textSize="13sp"/>
            <EditText android:id="@+id/etSizeY" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="SizeY 200" android:inputType="number" android:text="200" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="滤波 / 速度" android:textStyle="bold" android:textSize="14sp"
                android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/etSpatialFilter" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="空间滤波 0-10" android:inputType="number" android:text="0" android:textSize="13sp"/>
            <EditText android:id="@+id/etRisingSpeed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="上升速度 100" android:inputType="number" android:text="100" android:textSize="13sp"/>
            <EditText android:id="@+id/etFallingSpeed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="下降速度 100" android:inputType="number" android:text="100" android:textSize="13sp"/>

            <CheckBox android:id="@+id/cbAverage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="多次平均" android:textSize="13sp"/>
            <EditText android:id="@+id/etAverageNumber" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="平均次数" android:inputType="number" android:text="10" android:textSize="13sp"/>
            <CheckBox android:id="@+id/cbFlip" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="水平翻转" android:textSize="13sp"/>
            <CheckBox android:id="@+id/cbColors" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="彩色光谱" android:textSize="13sp" android:checked="true"/>
            <CheckBox android:id="@+id/cbPeaks" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="标记峰值" android:textSize="13sp" android:checked="true"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="波长校准 (bin | nm)" android:textStyle="bold" android:textSize="14sp"
                android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/etCalib" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="例如 1000|436;2000|546"
                android:text="1000|436;2000|546" android:textSize="12sp"
                android:inputType="textMultiLine" android:minLines="2"/>
            <Button android:id="@+id/btnApplyCalib" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="应用校准" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="摄像头控制" android:textStyle="bold" android:textSize="14sp"
                android:layout_marginTop="8dp"/>
            <Spinner android:id="@+id/spinnerCamera" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <SeekBar android:id="@+id/seekExposure" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="20" />
            <TextView android:id="@+id/tvExposure" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="曝光补偿: 0" android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekGain" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="100" />
            <TextView android:id="@+id/tvGain" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="增益: 0" android:textSize="12sp"/>
            <CheckBox android:id="@+id/cbTorch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="补光灯" android:textSize="13sp"/>

            <Button android:id="@+id/btnSettings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="更多设置" android:textSize="13sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
